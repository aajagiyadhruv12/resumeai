# Flask Settings
SECRET_KEY=<your-secret-key>
FLASK_DEBUG=False

# Legacy hardcoded Admin overrides (Optional — see routes/admin.py; deprecated. Override these to change fallback admin creds)
ADMIN_EMAIL=admin@resumeai.com
ADMIN_PASSWORD=Admin@1234
ADMIN_USERNAME=admin
# Secret used to sign admin JWTs — set a strong random value (falls back to SECRET_KEY)
ADMIN_JWT_SECRET=<your-admin-jwt-secret>

# Firebase Service Account (backend — used for verify ID tokens, Firestore, Storage, create Firebase Auth admin ops)
FIREBASE_PROJECT_ID=<your-project-id>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-private-key>\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=<your-service-account-email>
FIREBASE_STORAGE_BUCKET=<your-storage-bucket>

# Frontend Firebase Client SDK env vars (SET THESE IN VERCEL for frontend project for Frontend)
# These map to frontend/.env and/or Vercel env vars — required for the React app)
# REACT_APP_FIREBASE_API_KEY=<firebase-web-api-key>
# REACT_APP_FIREBASE_AUTH_DOMAIN=<project-id.firebaseapp.com
# REACT_APP_FIREBASE_PROJECT_ID=<your-project-id>
# REACT_APP_FIREBASE_STORAGE_BUCKET=<your-storage-bucket>
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
# REACT_APP_FIREBASE_APP_ID=<1:...>
# Backend API URL (for frontend production)
# REACT_APP_API_URL=https://your-backend.onrender.com/api

# AI API Keys
GOOGLE_API_KEY=<your-google-api-key>
OPENAI_API_KEY=<your-openai-api-key>

# SambaNova Settings (Optional)
SAMBANOVA_API_KEY=<your-sambanova-api-key>
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
